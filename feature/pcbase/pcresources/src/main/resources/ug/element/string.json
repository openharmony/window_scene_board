        },
        {
            "name":"permission_detail",
            "value":"<body><span style='normal'>بۇ ئۈسكۈنە ئاۋاز كىرگۈزۈش ۋە چىقىرىش كۆرۈنۈشلىرىدە AI ئاۋاز ئۈنۈمى ئىقتىدارى بىلەن تەمىنلەيدۇ. ئاۋاز كىرگۈزۈش (سۆزلىشىش ۋە ئۈن ئېلىش) كۆرۈنۈشلىرىدە AI شاۋقۇنسىزلاش ھېسابلاش ئۇسۇلى ئارقىلىق بىر كىشىلىك ئەھۋالدا «يالغۇز ئاۋاز ئايرىش» ئىقتىدارى بىلەن، كۆپ كىشىلىك ئەھۋالغا قارىتا «كۆپ كىشىلىك ئاۋاز ئايرىش» ئىقتىدارى بىلەن تەمىنلەيدۇ. ئاۋاز چىقىرىش كۆرۈنۈشلىرى ئۈچۈن، ئۈن-سىن قويۇش كۆرۈنۈشلىرىدە «AI تەڭكەش» ۋە «AI ئاۋاز گەۋدىلەندۈرۈش» ئىقتىدارى بىلەن، چاقىرىق كۆرۈنۈشلىرىدە «چاقىرىق شاۋقۇنسىزلاش» ئىقتىدارى بىلەن تەمىنلەيدۇ.</span><span style='wrap'>\n-</span><span style='title'>\nبىرىنچى، سۆزلەشكەندە يالغۇز ئاۋاز ئايرىش</span><span style='wrap'>\n-</span><span style='normal'>\nبۇ ئۈسكۈنىگە سۆزلەشكەندە يالغۇز ئاۋاز ئايرىش ئىقتىدارى سەپلەنگەن بولۇپ، بۇ ئىقتىدار ئاۋاز ئىزى ئۇچۇرى ئارقىلىق سۆزلەشكۈچىنىڭ ئاۋازىنى تونۇپ، باشقا شاۋقۇنلارنى توسىدۇ ياكى يوقىتىدۇ، بۇ ئارقىلىق سۆزلەشكۈچىنىڭ ئاۋازى قارشى تەرەپكە تېخىمۇ سۈزۈك يەتكۈزۈلىدۇ.</span><span style='wrap'>\n-</span><span style='bold'>\nھەرقانداق تېخنىكا چەكلىمە ۋە خەۋپتىن خالى ئەمەس، سۆزلەشكەندە ئاۋاز ئايرىش ئىقتىدارىنى ئىشلەتكەندە تۆۋەندىكىلەرگە دىققەت قىلىش كېرەك:</span><span style='normal'>\n%1$d. تېلېفونلاشقاندا سۆزلەشكۈچىنىڭ ئاۋاز ئىزى ئۆزلۈكىدىن ئېلىنىدۇ، بۇ ئىقتىدار ئاۋاز ئىزىنى ئېلىپ بولغاندىن كېيىن ئىشلەيدۇ.\n%2$d. تېلېفونلاشقاندا ئەتراپتىكى شاۋقۇن يۇقىرى بولسا، ئاۋاز ئىزى ئېلىشقا تەسىر يېتىپ، بۇ ئىقتىدار نورمال ئىشلىمەسلىكى مۇمكىن.\n%3$d. تاقىغان تىڭشىغۇچ ياكى تاقاش ئۇسۇلىغا قاراپ، شاۋقۇن تۆۋەنلىتىش ئۈنۈمىدە پەرق كۆرۈلۈشى مۇمكىن.\n%4$d. بۇ ئىقتىدار پەقەت شۇ قېتىملىق چاقىرىقتا بىر سۆزلەشكۈچىنىڭ ئاۋازىنى كۈچەيتىشكە ئىشلەيدۇ، سۆزلىشىۋاتقاندا سۆزلەشكۈچى ئالماشسا، ئاۋاز تۆۋەنلەپ كېتىشى مۇمكىن، بۇ ئەھۋالدا ئاۋاز ئايرىش ئىقتىدارىنى ئېتىشىڭىز كېرەك.\n%5$d. ئاۋاز ئىزى بىلەن شاۋقۇن ئوخشاپ قالسا، سۆزلەشكۈچىنىڭ ئاۋازى شاۋقۇن قاتارىدا توسۇلۇپ قېلىشى ياكى يوقىتىلىشى مۇمكىن.</span><span style='wrap'>\n-</span><span style='bold'>\nمەخپىيەتلىك باياناتى</span><span style='normal'>\n</span><span style='bold'>ئاۋاز ئىزى ئۇچۇرى</span><span style='normal'> قاتتىق قوغدىلىدۇ. بۇ ئۇچۇرلار ساقلانمايدۇ، خۇاۋېي ئۇلارنى زاپاسلىمايدۇ، ئەپمۇ ئۇلارنى ئوقۇيالمايدۇ. مەسىلەن، ئاۋاز ئايرىش ئىقتىدارى ئارقىلىق سۆزلەشكەندە، چاقىرىق ئەپى پەقەت شاۋقۇنسىزلاپ كۈچەيتىلگەن ئاۋاز سىگنالىنى قوبۇللايدۇ، </span><span style='bold'>ئاۋاز ئىزى</span><span style='normal'> ئۇچۇرىنى زىيارەت قىلالمايدۇ، زاپاسلىيالمايدۇ ياكى ئوقۇيالمايدۇ.\nئاۋاز ئىزى ئۇچۇرىنى باشقۇرۇش ھوقۇقى سىزدە، ئۇنى ئىشلىتىش ۋە ئىشلىتىش دائىرىسىنى ئۆزىڭىز خالىغانچە تىزگىنلەيسىز. يالغۇز ئاۋاز ئايرىش ئىقتىدارى كېرەك بولمىسا، تەڭشەك > ئاۋاز > كىرگۈزۈش دېگەن ئورۇندىن ئېتىپ قويسىڭىز بولىدۇ. كېيىن قايتا ئىشلەتسىڭىز، بۇ ئىقتىدار ئاۋاز ئىزى ئۇچۇرىنى قايتا ئوقۇيدۇ.</span><span style='wrap'>\n-</span><span style='title'>\nئىككىنچى، AI تەڭكەش ۋە AI ئاۋاز گەۋدىلەندۈرۈش</span><span style='wrap'>\n-</span><span style='normal'>\nبۇ ئۈسكۈنىگە </span><span style='bold'>AI تەڭكەش</span><span style='normal'> ۋە </span><span style='bold'>AI ئاۋاز گەۋدىلەندۈرۈش</span><span style='normal'> ئىقتىدارى سەپلەنگەن. </span><span style='bold'>AI تەڭكەش</span><span style='normal'> ئىقتىدارى قويۇۋاتقان ئۈن-سىندىكى ئادەم ئاۋازىنى AI ئۈلگە ئارقىلىق تۆۋەنلىتىپ، مۇزىكىنى ئايرىپ بېرەلەيدۇ؛ </span><span style='bold'>AI ئاۋاز گەۋدىلەندۈرۈش</span><span style='normal'> ئىقتىدارى قويغان ئۈن-سىندىكى مۇزىكىنى تۆۋەنلىتىپ، ئادەم ئاۋازىنى ئايرىپ بېرىدۇ، بۇ ئارقىلىق شاۋقۇنلۇق ئاۋازدىكى ئادەم ئاۋازىنى تېخىمۇ ئېنىق ئاڭلىغىلى بولىدۇ.</span><span style='wrap'>\n-</span><span style='bold'>\nھەرقانداق تېخنىكا چەكلىمە ۋە خەۋپتىن خالى ئەمەس، AI تەڭكەش ۋە AI ئاۋاز گەۋدىلەندۈرۈش ئىقتىدارىنى ئىشلەتكەندە تۆۋەندىكىلەرگە دىققەت قىلىش كېرەك:</span><span style='normal'>\n%6$d. بۇ ئىقتىدار پەقەت بىر قىسىم ئەپ ۋە بىر قىسىم ئۈسكۈنە (پەقەت ياڭراتقۇ ۋە تىڭشىغۇچ) دە ئىشلەيدۇ، نورمال ئىشلىگەن ئەمەلىي كۆرۈنۈش ئاساس.\n%7$d. ئاۋاز مەزمۇنىغا قاراپ AI تەڭكەش ئىقتىدارىنىڭ ئۈنۈمى ئوخشىمايدۇ، بەزىدە ئانچە-مۇنچە قالدۇق ئاۋازلار كۆرۈلۈشى مۇمكىن.\n%8$d. ئاۋاز مەزمۇنىغا قاراپ AI ئاۋاز گەۋدىلەندۈرۈش ئۈنۈمى ئوخشىمايدۇ، بەزىدە ئادەم ئاۋازى بۇزۇلۇپ كېتىشى مۇمكىن.\n%9$d. ئۈسكۈنىنى قايتا قوزغاتسىڭىز، بۇ ئىقتىدار ئۆزلۈكىدىن ئېتىلىدۇ.</span><span style='wrap'>\n-</span><span style='bold'>\nمەسئۇلىيەت باياناتى</span><span style='bold'>\nئۈسكۈنىگە سەپلەنگەن AI تەڭكەش</span><span style='normal'> ۋە </span><span style='bold'>AI ئاۋاز گەۋدىلەندۈرۈش</span><span style='normal'> ئىقتىدارلىرىنى قولدا ئېچىش كېرەك. بۇ ئىقتىدارلارنى ئىشلىتىش ئىشلەتكۈچىنىڭ شەخسىي ھەرىكىتىدۇر. بۇ ئىقتىدارلارنى ئىشلىتىش سەۋەبلىك ھەرقانداق نەشر ھوقۇقى تالاش-تارتىشلىرى كۆرۈلسە، بارلىق ئاقىۋەتكە ئىشلەتكۈچى ئۆزى ئىگە.</span></body>",
            "attr":{
                "priority":"translate"
            }
        },
