      {
        "name": "ohos.permission.OPERATE_FINDNETWORK"
      },
      {
        "name": "ohos.permission.MANAGE_SHUTDOWN_FINDNETWORK"
      },
      {
        "name": "ohos.permission.POWER_MANAGER"
      },
      {
        "name": "ohos.permission.ACCESS_CUSTOM_RINGTONE"
      },
      {
        "name": "ohos.permission.GET_EDM_CONFIG"
      },
      {
        // 读取BMS的thirdPartyAppList.json文件权限
        "name": "ohos.permission.ACCESS_BUNDLE_DIR"
      },
      {
        // 控制中心读取已用流量权限
        "name": "ohos.permission.GET_NETWORK_STATS"
      },
      {
        // 通知中心设置want拉起原因参数 设置位置：NotificationStarterVm#setLaunchReasonFromNC
        "name": "ohos.permission.SET_LAUNCH_REASON_MESSAGE"
      },
      // 云盘同步接口权限
      {
        "name": "ohos.permission.CLOUDFILE_SYNC"
      },
      {
        // QXS设备pc模式，可以通过控制中心点击超级隐私图标改变超级隐私状态
