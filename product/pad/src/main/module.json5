{
  "module": {
    "name": "pad_sceneboard",
    "type": "entry",
    "srcEntry": "./ets/Application/AbilityStage.ets",
    "description": "$string:mainability_description",
    "mainElement": "com.ohos.sceneboard.MainAbility",
    "deviceTypes": [
      "default",
      "tablet"
    ],
    "definePermissions": [
      {
        "name": "ohos.permission.ACCESS_CUSTOM_RINGTONE"
      },
      {
        "name": "ohos.permission.GET_EDM_CONFIG",
        "grantMode": "system_grant",
        "availableLevel": "system_basic",
        "provisionEnable": true,
        "distributedSceneEnable": false
      },
      {
        "name": "ohos.permission.ACCESS_TRUST_LIST_OOBE_MANAGER",
        "grantMode": "system_grant",
        "availableLevel": "system_core",
        "provisionEnable": true,
        "distributedSceneEnable": false
      },
      {
        "name": "ohos.permission.RECEIVE_BMS_BROKER_MESSAGES",
        "grantMode": "system_grant",
        "availableLevel": "system_basic",
        "provisionEnable": true,
        "distributedSceneEnable": false
      }
    ],
    "metadata": [
      {
        "name": "support_bluetooth_lyric",
        "value": "true"
      },
      {
        "name": "ArkTSPartialUpdate",
        "value": "true"
      },
      {
        "name": "action.settings.search.path",
        "value": "searchConfigDesktop/searchPage.json"
      },
      {
        "name": "action.settings.app.disable_force_stop",
        "value": "true"
      },
      {
        "name": "configColorModeChangePerformanceInArkUI",
        "value": "true"
      },
      {
        "name": "action.settings.app.can_not_disable",
        "value": "true"
      }
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "exported": false,
        "name": "DesktopIntentBackgroundUiAbility",
        "description": "DesktopIntentBackgroundUiAbility",
        "label": "$string:Desktop_setting",
        "srcEntry": "./ets/intents/DesktopIntentBackgroundUiAbilityRedirect.ets",
        "launchType": "singleton",
        "orientation": "portrait",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "removeMissionAfterTerminate": true
      },
      {
        "exported": false,
        "name": "ScbIntentUIAbility",
        "description": "ScbIntentUIAbility",
        "label": "$string:entry_MainAbility",
        "srcEntry": "./ets/intents/abilities/ScbIntentUIAbilityRedirect.ets",
        "launchType": "singleton",
        "orientation": "auto_rotation_restricted",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:scb_intent_start_window_background",
        "removeMissionAfterTerminate": true,
        "excludeFromMissions": true
      }
    ],
    "extensionAbilities": [
      {
        "priority": 5,
        "skills": [
          {
            "entities": [
              "entity.system.home",
              "flag.home.intent.from.system"
            ],
            "actions": [
              "action.system.home",
              "com.ohos.action.main",
              "action.form.publish"
            ]
          }
        ],
        "visible": false,
        "name": "com.ohos.sceneboard.MainAbility",
        "icon": "$media:icon",
        "description": "$string:mainability_description",
        "label": "$string:entry_MainAbility",
        "srcEntry": "./ets/MainAbility/MainAbility.ets",
        "type": "service"
      },
      {
        "exported": true,
        "name": "DesktopProviderService",
        "icon": "$media:icon",
        "description": "DesktopProviderService",
        "srcEntry": "./ets/service/DesktopProviderService.ets",
        "type": "service",
        "permissions": [
          "ohos.permission.GET_BUNDLE_INFO_PRIVILEGED"
        ],
        "metadata": [
          {
            "name": "ohos.extension.version",
            "value": "12"
          }
        ]
      },
      {
        "exported": true,
        "name": "OobeService",
        "icon": "$media:icon",
        "description": "OobeService",
        "srcEntry": "./ets/service/OobeService.ets",
        "type": "service",
        "permissions": [
          "ohos.permission.GET_BUNDLE_INFO_PRIVILEGED"
        ],
        "metadata": [
          {
            "name": "ohos.extension.version",
            "value": "1"
          }
        ]
      },
      {
        "exported": true,
        "name": "PageRouterService",
        "icon": "$media:icon",
        "description": "PageRouterService",
        "srcEntry": "./ets/service/PageRouterService.ets",
        "type": "service",
        "metadata": [
          {
            "name": "ohos.extension.version",
            "value": "1"
          }
        ],
        "skills": [
          {
            "actions": [
              "action.form.page"
            ]
          }
        ]
      },
      {
        "name": "ScbIntentUIExtensionAbility",
        "srcEntry": "./ets/intents/abilities/ScbIntentUIExtensionAbilityRedirect.ets",
        "description": "Scene board Intent UI Extension Ability",
        "type": "sys/commonUI",
        "exported": true,
        "permissions": [
          "ohos.permission.ACCESS_SYSTEM_SETTINGS"
        ]
      },
      {
        "name": "ReportWorkSchedulerExtensionAbility",
        "srcEntry": "./ets/SceneBoard/desktopReporter/ReportWorkSchedulerExtensionAbilityRedirect.ets",
        "label": "$string:WorkSchedulerExtensionAbility_label",
        "description": "$string:WorkSchedulerExtensionAbility_desc",
        "type": "workScheduler"
      },
      {
        "name": "EditModeIconAbilityPhone",
        "description": "EditModeIconAbilityPhone",
        "type": "sys/commonUI",
        "exported": true,
        "srcEntry": "./ets/desktopedit/ability/EditModeIconAbilityPhoneRedirect.ets",
        "permissions": [
          "ohos.permission.ACCESS_SYSTEM_SETTINGS"
        ]
      },
      {
        "name": "DesktopSettingUIExtAbility",
        "description": "DesktopSettingUIExtAbility",
        "type": "sys/commonUI",
        "exported": true,
        "srcEntry": "./ets/desktopsetting/ability/DesktopSettingAbilityRedirect.ets"
      },
      {
        "name": "ThreeButtonUpgradeDSExtAbility",
        "srcEntry": "./ets/SceneBoard/naviBar/ability/ThreeButtonUpgradeDSExtAbilityRedirect.ets",
        "description": "ThreeButtonUpgradeDSExtAbility",
        "type": "dataShare",
        "uri": "datashare://ThreeButtonUpgradeDSExtAbility",
        "exported": true,
        "readPermission": "ohos.permission.ALLOW_UPGRADE_GUIDE_ACCESS"
      },
      {
        "name": "ThreeButtonUpgradeUIExtAbility",
        "description": "ThreeButtonUpgradeUIExtAbility",
        "type": "sys/commonUI",
        "exported": true,
        "srcEntry": "./ets/SceneBoard/naviBar/ability/ThreeButtonUpgradeUIExtAbilityRedirect.ets",
        "permissions": [
          "ohos.permission.ALLOW_UPGRADE_GUIDE_ACCESS"
        ]
      },
      {
        "name": "SceneBoardFormAbility",
        "srcEntry": "./ets/FormAbility/SceneBoardFormAbility.ets",
        "description": "SceneBoardFormAbility",
        "type": "form",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      },
      {
        "name": "ExtHomeProviderService",
        "srcEntry": "./ets/service/ExtHomeProviderService.ets",
        "description": "ExtHomeProviderService",
        "type": "service",
        "exported": false,
        "permissions": [
          "ohos.permission.ACCESS_SCREEN_LOCK_INNER"
        ]
      },
      {
        "name": "SinglePocketProviderService",
        "srcEntry": "./ets/service/SinglePocketProviderService.ets",
        "description": "SinglePocketProviderService",
        "type": "service",
        "exported": false,
        "permissions": [
          "ohos.permission.ACCESS_SYSTEM_SETTINGS"
        ]
      },
      {
        "name": "StatusBarExtensionService",
        "srcEntry": "./ets/service/StatusBarExtensionService.ets",
        "type": "service",
        "exported": true,
        "description": "service"
      },
      {
        "name": "ScreenLockExtensionService",
        "srcEntry": "./ets/service/ScreenLockExtensionService.ets",
        "description": "ScreenLockExtensionService",
        "type": "service",
        "exported": true,
        "permissions": [
          "ohos.permission.ACCESS_SCREEN_LOCK"
        ]
      },
      {
        "name": "RestoringTipsAbility",
        "srcEntry": "./ets/restoringtips/RestoringTipsAbilityRedirect.ets",
        "description": "RestoringTipsDialog",
        "exported": false,
        "type": "sysDialog/common"
      },
      {
        "srcEntry": "./ets/SystemDialog/ExtAbility.ets",
        "name": "com.ohos.sceneboard.systemdialog",
        "description": "System-Dialog ServiceExtensionAbility",
        "type": "service",
        "exported": true,
        "permissions": [
          "ohos.permission.START_SYSTEM_DIALOG"
        ]
      },
      {
        "srcEntry": "./ets/SystemDialog/CFWKExtAbility.ets",
        "name": "com.ohos.sceneboard.cfwksystemdialog",
        "description": "System-Dialog ServiceExtensionAbility",
        "type": "service",
        "exported": true,
        "permissions": [
          "ohos.permission.START_SYSTEM_DIALOG"
        ]
      },
      {
        "name": "PoweroffAbility",
        "srcEntry": "./ets/SystemDialog/PoweroffAbility.ets",
        "description": "PowerOffAbility",
        "exported": false,
        "type": "sysDialog/common",
        "permissions": [
          "ohos.permission.REBOOT"
        ]
      },
      {
        "srcEntry": "./ets/SystemDialog/AlertAbility.ets",
        "name": "com.ohos.sceneboard.alert",
        "description": "System-Dialog AlertAbility",
        "type": "sysDialog/common",
        "exported": false
      },
      {
        "srcEntry": "./ets/SceneBoard/oneHandModeDialog/ability/OneHandModeDialogAbilityRedirect.ets",
        "name": "OneHandModeDialogAbility",
        "description": "System-Dialog OneHandModeDialogAbility",
        "type": "sysDialog/common",
        "exported": false
      },
      {
        "visible": false,
        "name": "SoundPermissionAbility",
        "srcEntry": "./ets/SceneBoard/soundpanel/permission/SoundPermissionAbility.ets",
        "description": "SoundPermissionAbility_desc",
        "label": "$string:sound",
        "exported": false,
        "type": "sysDialog/common"
      },
      {
        "name": "WallpaperComponentExtAbility",
        "srcEntry": "./ets/SceneBoard/themeeditor/WallpaperComponentExtAbility.ets",
        "exported": true,
        "type": "service",
        "icon": "$media:icon",
        "extensionProcessMode": "type",
        "permissions": [
          "ohos.permission.ACTIVATE_THEME_PACKAGE"
        ]
      },
      {
        "name": "IntentServiceExtAbility",
        "srcEntry": "./ets/service/IntentServiceExtAbility.ets",
        "type": "service",
        "exported": true,
        "description": "service",
        "permissions": [
          "ohos.permission.EXECUTE_INSIGHT_INTENT"
        ]
      },
      {
        "visible": false,
        "name": "ExtendedScreenDialogAbility",
        "srcEntry": "./ets/SystemDialog/ExtendedScreenDialog/ability/ExtendedScreenDialogAbility.ets",
        "description": "ExtendedScreenDialogAbility_desc",
        "label": "$string:sound",
        "exported": false,
        "type": "sysDialog/common"
      }
    ],
    "requestPermissions": [
      // acl
      {
