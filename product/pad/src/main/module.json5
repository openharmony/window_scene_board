      },
      {
        "name": "ohos.permission.PROXY_AUTHORIZATION_URI"
      },
      {
        "name": "ohos.permission.ACCESS_LOWPOWER_MANAGER"
      },
      {
        "name": "ohos.permission.ACTIVATE_THEME_PACKAGE"
      },
      {
        "name": "ohos.permission.ACCESS_SYSTEM_SETTINGS"
      },
      {
        // 通知中心用于系统迁移/双克隆单场景恢复延迟安装应用的开关 事件监听位置：NotificationRestoreManager#subscriberDelayedRestore()
        "name": "ohos.permission.START_RESTORE_NOTIFICATION"
      },
      {
        // 通知中心用于DH应用系统迁移/双克隆单场景恢复延迟安装应用的开关 事件监听位置：NotificationRestoreManager#subscriberDeliverRestoreStart()
        "name": "ohos.permission.RECEIVE_BMS_BROKER_MESSAGES"
      },
      {
        "name": "ohos.permission.ACCESS_APP_LOCK"
      },
      {
        // 通知中心用于监听应用加锁状态隐藏通知内容 事件监听位置：AppProtectedVm#init()
        "name": "ohos.permission.READ_APP_LOCK"
      },
      {
        "name": "ohos.permission.MANAGE_APP_INSTALL_INFO",
        "reason": "$string:permission_reason_manage_install",
        "usedScene": {
          "abilities": [
            "MainAbility"
          ],
          "when": "always"
        }
      },
      {
        "name":"ohos.permission.RECEIVE_APP_INSTALL_INFO_CHANGE",
        "reason": "$string:permission_reason_receive_install",
        "usedScene": {
          "abilities": [
            "MainAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.CHANGE_ABILITY_ENABLED_STATE"
      },
      {
        "name": "ohos.permission.GET_BUNDLE_RESOURCES"
