export class YearViewLayoutManager {
  private static _instance: YearViewLayoutManager;
  public layout: YearViewLayout = new YearViewLayout();
  public dayLayout: DayLayout = new DayLayout();
  public weekTitles: string[] = [];
  private defaultWeekTitles: string[] = [];
  private startOfWeek: number = 0;

  constructor() {
    this.getWeekTitles();
  }

  public static getInstance(): YearViewLayoutManager {
    if (!YearViewLayoutManager._instance) {
      YearViewLayoutManager._instance = new YearViewLayoutManager();
    }
    return YearViewLayoutManager._instance;
  }

  getWeekTitles() {
    this.defaultWeekTitles = this.getWeekTitle();
    this.updateWeekTitles();
    return this.weekTitles;
  }

  updateWeekTitles() {
    this.weekTitles =
      [...this.defaultWeekTitles.slice(this.startOfWeek),
        ...this.defaultWeekTitles.slice(0, this.startOfWeek)
      ];
  }

  onStartOfWeekChange(startOfWeek: number) {
    this.startOfWeek = startOfWeek;
    this.updateWeekTitles();
  }


  /**
   * 获取国际化星期字符
   *
   * @return 字符数组
   */
  getWeekTitle(): string[] {
    const systemLanguage = i18n.System.getSystemLanguage();
    const isChineseLanguage = systemLanguage.split('-')[0].toLocaleLowerCase() === 'zh';
    const date = new Date();
    const weekDay = date.getDay(); // 返回一周（0~6）的某一天的数字。星期天为 0, 星期一为 1, 以此类推。
    const sundayTimestamp = date.getTime() - weekDay * DateUtil.ONE_DAY_TIMESTAMP;

    return new Array(DateUtil.DAY_PER_WEEK).fill('').map((day: number, i): string => {
      const date = new Date(sundayTimestamp + i * DateUtil.ONE_DAY_TIMESTAMP);
      if (isChineseLanguage) {
        return this.DateFormat(date, { weekday: 'narrow' }, systemLanguage);
      } else {
        return this.DateFormat(date, { weekday: 'short' }, systemLanguage).toLocaleUpperCase();
      }
    });
  }

  DateFormat(date: Date, opt: intl.DateTimeOptions, systemLanguage: string): string {
    const locale: intl.Locale | undefined = new intl.Locale(systemLanguage);
    if (!locale) {
      return '';
    }
    const dateFormat: intl.DateTimeFormat = new intl.DateTimeFormat(locale?.toString(), opt);
    const dateStr: string = dateFormat.format(date);
    // 存在内存泄漏，需要手动释放
    // MemoryUtils.removeNapiWrap(dateFormat, false);
    return dateStr;
  }
}

export class YearViewLayout {
  public margin: number = 8; // 单月视图左右外边距
  public maxHeight: number = 270; // 月视图展开高度
  public hopperMaxHeight: number = 280; // hopper设备下日历面板展开高度
  public minHeight: number = 68; // 月视图折叠高度

  public weekBottom: number = 8; // 周距离日视图的高度

