const TAG: string = 'Form - CardFormMonthViewModel';
const log: LogHelper = LogHelper.getLogHelper(LogDomain.SCB, TAG);

// 索引转换矩阵 0 标识当前页 -1 标识前一周/天 1标识后一周/天
const OFFSET_MATRIX: number[][] = [
  [0, 1, -1],
  [-1, 0, 1],
  [1, -1, 0]
];

const DEFAULT_WEEK_START_DAY: number = -1;
const WEEK_START_DAY_IS_SATURDAY: number = 6;

@Observed
class SingleMonthlyViewModelArray extends Array<SingleMonthViewModel> {
}

@Observed
export class PanelMonthViewModel {
  public readonly MAX_MONTH_COUNT: number = 3; // 页面缓存数量,需要与OFFSET_MATRIX保持一致
  public singleMonthlyViewModels: SingleMonthlyViewModelArray = new SingleMonthlyViewModelArray();
  //状态栏日历显示月份
  public displayMonth: number = new Date().getMonth() + 1;
  public displayYear: number = new Date().getFullYear();
  public currentDate: DateInfo;
  // 选中时间
  public selectDate: DateInfo = new DateInfo(0, 0, 0);
  // 当前页面的索引值
  public currentIndex: number = 1;
  public isWeekShow: boolean = false;
  public startOfWeek: number = 0;
  public showRecessData: boolean = false;
  public swiperController: SwiperController = new SwiperController();
  private isInit: boolean = false;
  private allRecessData: Map<number, RecessInfo> = new Map<number, RecessInfo>();
  private recessData: string = '';
  private isRecessFinished: boolean = true;
  // 是否为中国地区
  private isChina: boolean = true;
  private oldStartOfWeek: number = 0; // 记录上一次的一周开始日

  constructor() {
    const nowDate = new Date();
    this.currentDate = new DateInfo(nowDate.getFullYear(), nowDate.getMonth() + 1, nowDate.getDate());
    this.singleMonthlyViewModels = new Array(this.MAX_MONTH_COUNT);
  }


  /**
   * 根据当前显示年月信息，初始化数据，将数据序列化
   *
   * @param displayDate 当前展示日期
   * @param currentIndex 当前屏幕上显示索引
   */
  public reInitByMonth(displayDate: Date, isCollapse: boolean) {
    if (this.isInit) {
      return;
    }
    this.updateDisplayMonth(displayDate.getFullYear(), displayDate.getMonth() + 1);
    this.selectDate = new DateInfo(displayDate.getFullYear(), displayDate.getMonth() + 1, displayDate.getDate());
    DateManager.getInstance().selectedDay =
      new DayData(displayDate.getFullYear(), displayDate.getMonth() + 1, displayDate.getDate());
    this.isWeekShow = isCollapse;
    log.showInfo(`reInitByMonthly dateInfo:${this.selectDate.month} ${this.selectDate.day}`);
    this.buildSingleMonthlyViewModels(this.selectDate, 1, isCollapse);
    this.updateRecess();
    this.updateStartOfWeek();
    this.isInit = true;
  }

  public updateDisplayMonth(disPlayYear: number, disPlayMonth: number) {
    this.displayYear = disPlayYear;
    this.displayMonth = disPlayMonth;
  }

  private async updateStartOfWeek() {
    const data: number | undefined = await CalendarUtils.getStartOfWeek();
    if (data === undefined) {
      log.showError('updateStartOfWeek data is illegal value');
      return;
    }
    if (data < DEFAULT_WEEK_START_DAY || data > WEEK_START_DAY_IS_SATURDAY) {
      log.showError('updateStartOfWeek data is illegal value');
      return;
    } else if (data === DEFAULT_WEEK_START_DAY) {
      this.startOfWeek = this.getDefaultStartOfWeek();
    } else {
      this.startOfWeek = data;
    }

    if (this.startOfWeek !== this.oldStartOfWeek) {
      this.singleMonthlyViewModels.forEach((item) => {
        item.onStartOfWeekChange(this.startOfWeek);
      });
    }
    this.oldStartOfWeek = this.startOfWeek;
  }

  async updateRecess() {
    if (this.recessData === '' && this.isRecessFinished === true) {
      this.isRecessFinished = false;
      try {
        this.recessData = await CalendarUtils.getRecessData();
      } catch (err) {
        log.showError(`getRecessData settings getValueSync err, code: ${err?.code}, message: ${err?.message}`);
        return;
      } finally {
        this.isRecessFinished = true;
      }
    }
    log.showInfo(`updateRecess recessData length: ${this.recessData.length}`);
    if (this.recessData !== null && this.recessData !== '') {
      this.processRecessData(this.recessData);
    }
  }

  async processRecessData(data: string) {
    const recessSwitchData: string = await CalendarUtils.getRecessSwitch();
    let isRecessSwitchOpen = recessSwitchData && recessSwitchData === '1' ? true : false;
    let isRecessShow = data !== '' && this.isChina && isRecessSwitchOpen;
    let yearData = Recess.parseDataToRecess(data, CalendarUtils.isOldRecess);
    yearData?.recessInfo.forEach((item: RecessInfo) => {
      if (!this.allRecessData.has(item.recessYear)) {
        this.allRecessData.set(item.recessYear, item);
      }
    });
    this.onRecessDataChange(this.allRecessData, isRecessShow);
  }

  /**
   * 构造单月模型数组，构建双端的链表
   *
   * @param displayMonth
   * @param currentIndex
   */
  buildSingleMonthlyViewModels(dateInfo: DateInfo, currentIndex: number, weekShow: boolean) {
    // 初始化 singleMonthlyViewModels 数组
    this.singleMonthlyViewModels = new Array(this.MAX_MONTH_COUNT);
    const newDateInfo = new Date(dateInfo.year, dateInfo.month - 1, dateInfo.day);
    this.updateSingleViewModelByIndex(currentIndex, newDateInfo, weekShow);
    // 分别向数组两端初始化
    if (weekShow) {
      this.initMonthArrayWeekShow(currentIndex);
    } else {
      this.initMonthArray(currentIndex);
    }
  }


  initMonthArrayWeekShow(currentIndex: number) {
    let tempNode: SingleMonthViewModel = this.singleMonthlyViewModels[currentIndex];

    for (let i = currentIndex + 1; i <= this.MAX_MONTH_COUNT - 1; i++) {
      const displayDate = tempNode.selectDate.getDate().getTime();
      const newDisplayDate = new Date(displayDate + MILLS_PER_WEEK);
      this.updateSingleViewModelByIndex(i, newDisplayDate, this.isWeekShow);
      tempNode = this.singleMonthlyViewModels[i];
    }
    tempNode = this.singleMonthlyViewModels[currentIndex];
    for (let i = currentIndex - 1; i >= 0; i--) {
      const displayDate = tempNode.selectDate.getDate().getTime();
      const newDisplayDate = new Date(displayDate - MILLS_PER_WEEK);
      this.updateSingleViewModelByIndex(i, newDisplayDate, this.isWeekShow);
      tempNode = this.singleMonthlyViewModels[i];
    }
  }

  initMonthArray(currentIndex: number) {
    let tempNode: SingleMonthViewModel = this.singleMonthlyViewModels[currentIndex];
    for (let i = currentIndex + 1; i <= this.MAX_MONTH_COUNT - 1; i++) {
      const tempMonth = new Date(tempNode.year, tempNode.month, 1);
      this.singleMonthlyViewModels[i] =
        new SingleMonthViewModel(tempMonth.getFullYear(), tempMonth.getMonth() + 1, 1, this.startOfWeek);
      tempNode = this.singleMonthlyViewModels[i];
    }
    tempNode = this.singleMonthlyViewModels[currentIndex];
    for (let i = currentIndex - 1; i >= 0; i--) {
      const tempMonth = new Date(tempNode.year, tempNode.month - 2, 1);
      this.singleMonthlyViewModels[i] =
        new SingleMonthViewModel(tempMonth.getFullYear(), tempMonth.getMonth() + 1, 1, this.startOfWeek);
      tempNode = this.singleMonthlyViewModels[i];
    }
  }

  onSwiperIndexChange(index: number): void {
    // Swiper 滑动
    if (this.currentIndex === index) {
      return;
    }

    // 全量更新月份数据 VM
    this.updateDataArray(index, this.currentIndex);
  }

  /**
   * 更新日期数组 用于更新当前
   *
   * @param index 新的索引
   * @param lastIndex 旧的索引
   */
  updateDataArrayForAnimate(index: number) {
    const curMonthlyInfo: SingleMonthViewModel | undefined = this.singleMonthlyViewModels[index];
    if (!curMonthlyInfo) {
      log.showError('updateDataArrayForAnimate NO VALID CUR MONTHLY INFO!');
      return;
    }
    const year: number = curMonthlyInfo.year;
    const month: number = curMonthlyInfo.month;

    this.updateDisplayMonth(year, month);

  }

  /**
   * 更新日期数组
   *
   * @param index 新的索引
   * @param lastIndex 旧的索引
   */
  updateDataArray(index: number, lastIndex: number) {
    const curMonthlyInfo: SingleMonthViewModel | undefined = this.singleMonthlyViewModels[index];

    if (!curMonthlyInfo) {
      log.showError('NO VALID CUR MONTHLY INFO!');
      return;
    }

    log.showInfo(`index: ${index}, lastIndex: ${lastIndex}`);

    this.currentIndex = index;

    // 当前展示的年、月信息
    this.updateDateInfo(curMonthlyInfo, index);

    const arrowList = OFFSET_MATRIX[lastIndex];
    if (arrowList === undefined) {
      log.showError(`index err can not get arrow list ${lastIndex}`);
      return;
    }

    const arrow = arrowList[index];
    if (arrow === undefined) {
      log.showError(`index err can not get arrow list ${index}`);
      return;
    }

    const currentNode: SingleMonthViewModel | undefined = this.singleMonthlyViewModels[index];
    if (!currentNode) {
      log.showError(`get month view model error undefined ${index}`);
      return;
    }

    const updateIndex = (this.MAX_MONTH_COUNT + index + arrow) % this.MAX_MONTH_COUNT;

    if (this.isWeekShow) {
      const updateDate = new Date(currentNode.selectDate.getDate().getTime() + MILLS_PER_WEEK * arrow);
      this.updateSingleViewModelByIndex(updateIndex, updateDate, this.isWeekShow);
    } else {
      const updateDate = new Date(currentNode.year, currentNode.month - 1, 1);
      const nowDate = new Date();
      updateDate.setMonth(updateDate.getMonth() + arrow);
      if (nowDate.getFullYear() === updateDate.getFullYear() && nowDate.getMonth() === updateDate.getMonth()) {
        updateDate.setDate(nowDate.getDate());
      }
      this.updateSingleViewModelByIndex(updateIndex, updateDate, this.isWeekShow);

      // 更新已翻页的选中日期
      this.reInitMonthlySelectDate(lastIndex);
    }
    this.updateRecess();
  }

  /**
   * 重新初始化对应index的选中日期
   * @param index
   */
  reInitMonthlySelectDate(index: number) {
    const curMonthlyModel: SingleMonthViewModel | undefined = this.singleMonthlyViewModels[index];

    if (!curMonthlyModel) {
      log.showError('NO VALID CUR MONTHLY INFO TO RE INIT!');
      return;
    }

    const curDate: Date = new Date();
    const curYear: number = curDate.getFullYear();
    const curMonth: number = curDate.getMonth() + 1;
    const day: number =
      (curYear === curMonthlyModel.year && curMonth === curMonthlyModel.month) ? curDate.getDate() : 1;
    const reInitDateInfo: DateInfo = new DateInfo(curMonthlyModel.year, curMonthlyModel.month, day);
    curMonthlyModel.onSelectedDateChange(reInitDateInfo);
  }


  updateDateInfo(curMonthlyInfo: SingleMonthViewModel, index: number) {
    let year: number = 0;
    let month: number = 0;
    let day: number = 0;
    let newDisplayDate: Date = new Date();
    if (this.isWeekShow) {
      const nowDateInfo = curMonthlyInfo.selectDate;
      year = nowDateInfo.year;
      month = nowDateInfo.month;
      day = nowDateInfo.day;
      newDisplayDate = new Date(year, month - 1, day);
      newDisplayDate.setHours(0, 0, 0, 0);
      this.updateDisplayMonth(year, month);
    } else {
      year = curMonthlyInfo.year;
      month = curMonthlyInfo.month;
      const curDate: Date = new Date();
      const curYear: number = curDate.getFullYear();
      const curMonth: number = curDate.getMonth() + 1;
      day = (curYear === year && curMonth === month) ? curDate.getDate() : 1;
      newDisplayDate = new Date(year, month - 1, day);
      newDisplayDate.setHours(0, 0, 0, 0);
      this.updateDisplayMonth(year, month);
    }
    this.selectDate = new DateInfo(year, month, newDisplayDate.getDate());
    DateManager.getInstance().selectedDay =
      new DayData(year, month, newDisplayDate.getDate());
  }


  /**
   * update SingleViewModel By Index
   *
   * @param index the index of DataArray
   * @param monthlyInfo the month Info of SingleViewModel which is need to update
   * @param arrowState 更新方向
   * @param monthlyInfo 更新次数
   */
  updateSingleViewModelByIndex(index: number | undefined, updateDate: Date, isWeekShow: boolean) {
    if (index === undefined) {
      log.showError('NO VALID INDEX OF SingleViewModel!');
      return;
    }
    const year = updateDate.getFullYear();
    const month = updateDate.getMonth() + 1;
    const day = updateDate.getDate();
    log.showInfo(`update monthly model ${index}:${year}/${month}/${day}`);
    this.singleMonthlyViewModels[index] = new SingleMonthViewModel(year, month, day, this.startOfWeek);

    this.singleMonthlyViewModels[index].finishWeekUpdateByButton(isWeekShow);
  }

  // 响应选中日期变化
  public onCurrentDateChange(date: Date) {
    this.currentDate = new DateInfo(date.getFullYear(), date.getMonth() + 1, date.getDate());
    for (const model of this.singleMonthlyViewModels) {
      if (!model) {
        continue;
      }
      model.onCurrentDateChange(date);
    }
  }

  updateAllModel() {
    const offsetList = OFFSET_MATRIX[this.currentIndex];
    if (!offsetList) {
      log.showError('NO VALID INDEX OF offsetList!');
      return;
    }
    for (let i = 0; i < this.MAX_MONTH_COUNT; i++) {
      if (offsetList[i] === undefined) {
        continue;
      }
      if (!this.singleMonthlyViewModels[i]) {
        log.showError(`singleMonthlyViewModel is undefined ${i}`);
        continue;
      }
      const singleYear = this.singleMonthlyViewModels[i].year;
      const singleMonth = this.singleMonthlyViewModels[i].month;
      if (this.isWeekShow) {
        const displayDate =
          new Date(this.selectDate.year, this.selectDate.month - 1, this.selectDate.day, 0, 0, 0, 0).getTime();
        const indexSelectDate = new Date(displayDate + MILLS_PER_WEEK * offsetList[i]);
        if (indexSelectDate.getFullYear() === singleYear &&
          indexSelectDate.getMonth() + 1 === singleMonth) {
          this.singleMonthlyViewModels[i].onCurrentDateChange(this.currentDate.getDate());
          const indexSelectDateInfo =
            new DateInfo(indexSelectDate.getFullYear(), indexSelectDate.getMonth() + 1, indexSelectDate.getDate());
          this.singleMonthlyViewModels[i].onSelectedDateChange(indexSelectDateInfo);
        } else {
          this.updateSingleViewModelByIndex(i, indexSelectDate, this.isWeekShow);
        }
      } else {
        const indexSelectDate =
          new Date(this.selectDate.year, this.selectDate.month - 1 + offsetList[i], 1);
        const initDay = offsetList[i] === 0 ? this.selectDate.day :
          ((this.currentDate.year === indexSelectDate.getFullYear() &&
            this.currentDate.month === indexSelectDate.getMonth() + 1) ? this.currentDate.day : 1);
        indexSelectDate.setDate(initDay);
        this.updateSingleViewModelByIndex(i, indexSelectDate, this.isWeekShow);
      }
    }
    this.updateRecess();
  }

  // 响应选中日期变化
  public onSelectedDateChange() {
    if (!this.isInit) {
      return;
    }
    const nowSelectDay = DateManager.getInstance().selectedDay;
    log.showInfo(`selected day change ${nowSelectDay.solarYear} ${nowSelectDay.solarMonth} ${nowSelectDay.solarDay}`);
    const oldSelectDate = this.selectDate;
    if (nowSelectDay.solarYear !== oldSelectDate.year || nowSelectDay.solarMonth !== oldSelectDate.month) {
      this.updateDisplayMonth(nowSelectDay.solarYear, nowSelectDay.solarMonth);
      this.selectDate = new DateInfo(nowSelectDay.solarYear, nowSelectDay.solarMonth, nowSelectDay.solarDay);
      DateManager.getInstance().selectedDay =
        new DayData(nowSelectDay.solarYear, nowSelectDay.solarMonth, nowSelectDay.solarDay);
      this.updateAllModel();
      return;
    }

    this.updateDisplayMonth(nowSelectDay.solarYear, nowSelectDay.solarMonth);
    this.selectDate = new DateInfo(nowSelectDay.solarYear, nowSelectDay.solarMonth, nowSelectDay.solarDay);
    DateManager.getInstance().selectedDay =
      new DayData(nowSelectDay.solarYear, nowSelectDay.solarMonth, nowSelectDay.solarDay);
    if (this.isWeekShow) {
      this.finishWeekUpdateByButton(this.isWeekShow);
    } else {
      this.singleMonthlyViewModels[this.currentIndex].onSelectedDateChange(this.selectDate);
    }
  }

  public finishWeekUpdateByButton(isCollapse: boolean) {
    this.isWeekShow = isCollapse;

    this.updateAllModel();
    this.singleMonthlyViewModels.forEach((model, index) => {
      model.finishWeekUpdateByButton(isCollapse);
    });
  }

  public onRecessDataChange(allRecessData: Map<number, RecessInfo>, isShowRecess: boolean) {
    this.showRecessData = isShowRecess;
    this.singleMonthlyViewModels.forEach((model: SingleMonthViewModel) => {
      model?.onRecessDataChange(allRecessData, isShowRecess);
    });
  }

  public updateIsChinaRegion() {
    this.isChina = this.isChineseRegion();
  }

  /**
   * 系统设置是否为中国区域
   */
  isChineseRegion(): boolean {
    const region = i18n.System.getSystemRegion();
    log.showInfo('isChineseRegion region: ' + region);
    return region === 'CN';
  }

  /**
   * 获取系统默认地点的一周开始日
   *
   * @returns 系统默认地点的一周开始日
   */
  private getDefaultStartOfWeek(): number {
    const locale = i18n.System.getSystemLocale();
    const firstDayOfWeek: number = i18n.getCalendar(locale).getFirstDayOfWeek() - 1;
    return firstDayOfWeek;
  }

  // 时间更新刷新当前天
  refreshCurrentDate() {
    const date = new Date();
    const currentDate = this.currentDate;
    // 记录的当前天未发生变化
    if (currentDate.year === date.getFullYear() &&
      currentDate.month === date.getMonth() + 1 &&
      currentDate.day === date.getDate()) {
      return;
    }
    log.showInfo(`refreshCurrentDate:${date.getMonth() + 1}/${date.getDate()}`);
    this.onCurrentDateChange(date);
  }

  // 重新打开状态栏日历将选中天更新到当天
  refreshDate() {
    const date = new Date();
    const day = date.getDate();
    const selectDate = this.selectDate;
    this.updateStartOfWeek();
    this.updateRecess();

    // 选中天一致,不需要刷新视图和选中圈
    if (date.getFullYear() === selectDate.year &&
      date.getMonth() + 1 === selectDate.month &&
      date.getDate() === selectDate.day) {
      this.refreshCurrentDate();
      return;
    }
    DateManager.getInstance().selectedDay = new DayData(date.getFullYear(), date.getMonth() + 1, day);
    log.showInfo(`refreshDate day:${day}`);
    this.onSelectedDateChange();
    this.refreshCurrentDate();
  }
}

/**
 * 用于标识当前日期的接口，公历月份month:（1-12）day:(1-31)
 */
export class DateInfo {
  public year: number;
  public month: number;
  public day: number;

  constructor(year?: number, month?: number, day?: number) {
    this.year = year as number;
    this.month = month as number;
    this.day = day as number;
  }

  getDate(): Date {
    return (this.day === null || this.day === undefined) ? new Date(this.year, this.month - 1, 1) :
      new Date(this.year, this.month - 1, this.day);
  }

  toString(): string {
    return 'DateInfo year = ' + this.year + ', month = ' + this.month +
      ', day = ' + this.day;
  }
}

