@Observed
export class SingleDayViewModel {
  public day: number = -1;
  public isToday: boolean = false;
  public isSelect: boolean = false;
  public textColor: ResourceColor = $r('sys.color.ohos_id_color_text_secondary');
  public isOffDay: boolean = false; // 是周末休息或者法定节假日
  public isTodayMonth: boolean = true;
  public tagText: string = ''; // 节假日、节气、农历 归一化TAG
  public tagTextColor: ResourceColor = ''; // 颜色
  public hasFestivals: boolean = false; //是否有节假日
  public mark: DayMark = DayMark.NORMAL;
  public calendar: string = '占位';
  public showRecessData: boolean = false;
  public showLunar: boolean = false;
  public recessText: string = '';
  public recessTextColor: ResourceColor = '';
  public dayData: DayData = new DayData(0, 0, 0);
  public isCurrentMonth: boolean = true;
  public isWeekends: boolean = false;
  public term: string = ''; // 节气
  public holiday: string = ''; // 节日
  public isSelectWeekDays: boolean = false;
  public colorModeViewModel: ColorModeViewModel = ColorModeViewModel.getInstance();
  public colorModeViewData: ColorModeViewData = this.colorModeViewModel.getViewData();
  public textForegroundBrightness: BrightnessOptions | undefined = undefined;
  public tagTextForegroundBrightness: BrightnessOptions | undefined = undefined;
  public textAdvancedBlendMode: uiEffect.BrightnessBlender | undefined = undefined;
  public tagTextAdvancedBlendMode: uiEffect.BrightnessBlender | undefined = undefined;
  public isShowPopUp: boolean = false;
  public popupContent: string = '';
  public compId: string = 'default';
  public isWeekView: boolean = false;

  constructor() {
    this.isSelect = false;
  }

  initCompId() {
    this.compId =
      `singleDayView_${this.dayData.solarYear}_${this.dayData.solarMonth}_${this.dayData.solarDay}`;
  }

  update(data?: DayData, showRecess: boolean = false, showLunar: boolean = true,
    weekends: number[] = [], isCurrentMonth: boolean = true): void {
    if (!data) {
      this.day = -1;
      this.isToday = false;
      this.isSelect = false;
      this.tagText = '';
      this.showRecessData = false;
      return;
    }
    this.isCurrentMonth = isCurrentMonth;
    this.dayData = data;
    this.isSelect = false;
    this.day = data.solarDay;
    this.mark = data.dayMark;
    this.showRecessData = showRecess;
    this.showLunar = showLunar;
    this.isSelectWeekDays = false;

    this.isToday = this.parseIsToday();
    const weekDay = data.getWeekDay();
    if (weekends.indexOf(weekDay) !== -1) {
      this.isWeekends = true;
    } else {
      this.isWeekends = false;
    }
    this.parseHolidayAndTerm(data);
    this.updateDayCell();
  }

  updateTagColor() {
    const maxStrLength: number = this.isSelect ? 3 : 4;
    if (this.tagText.length > maxStrLength) {
      this.tagText = this.tagText.slice(0, maxStrLength - 1) + '...';
    }

    if (this.isToday && this.isSelect) {
      this.tagTextColor = this.colorModeViewData.commonIconOnColor; // 今天选中
      this.tagTextForegroundBrightness = this.colorModeViewData.foregroundPrimaryOnOption;
      this.tagTextAdvancedBlendMode = undefined;
      return;
    }

    if (this.isToday) {
      this.tagTextColor = $r('app.color.calendar_color_blue'); // 今天未选中
      this.tagTextForegroundBrightness = undefined;
      this.tagTextAdvancedBlendMode = undefined;
      return;
    }

    // rule: 2.无节假日
    if (!this.hasFestivals) {
      if (!this.isCurrentMonth || this.isWeekends) { // 非当月或者周末
        this.tagTextAdvancedBlendMode = BlendModeUtil.getBlenderTertiary();
      } else { // 其它场景
        this.tagTextForegroundBrightness = this.colorModeViewData?.foregroundPrimaryOption;
      }
      this.tagTextColor = this.colorModeViewData.wifiOffTextColor;
    } else {
      // rule: 3.有节假日，均为主题色
      this.tagTextColor = $r('app.color.calendar_color_blue');
    }
  }


  /**
   * 处理节假日和节气
   */
  parseHolidayAndTerm(dayData: DayData): void {
    let tempTerm: string = '';
    let tempHoliday: string = '';
    for (let i = 0; i < dayData.festivals.length; i++) {
      if (tempTerm === '' && dayData.festivals[i].type === FestivalType.SOLAR_TERM) {
        tempTerm = dayData.festivals[i].name;
      }
      if (tempHoliday === '' && dayData.festivals[i].type !== FestivalType.SOLAR_TERM) {
        tempHoliday = dayData.festivals[i].name;
      }
    }
    this.term = tempTerm;
    this.holiday = tempHoliday;
    this.calendar = LunarCalendar.parseLeapLunaMonth(dayData);
    this.hasFestivals = this.term.length !== 0 || this.holiday.length !== 0;
    return;
  }

  updateDateTextColor(): void {
    if (this.isSelect && this.isToday) {
      this.textColor = this.colorModeViewData.commonIconOnColor;
      this.textForegroundBrightness = this.colorModeViewData.foregroundPrimaryOnOption; // 今天选中
      this.textAdvancedBlendMode = undefined;
      return;
    }
    if (this.isToday) {
      this.textColor = $r('app.color.calendar_color_blue'); // 今天未选中
      this.tagTextForegroundBrightness = undefined;
      this.tagTextAdvancedBlendMode = undefined;
      return;
    }

    if (!this.isCurrentMonth || this.isWeekends) { // 非当月或者周末
      this.textAdvancedBlendMode = BlendModeUtil.getBlenderTertiary();
    } else { // 其它场景
      this.textForegroundBrightness = this.colorModeViewData.foregroundPrimaryOption;
    }
    this.textColor = this.colorModeViewData.wifiOffTextColor;
  }

  /**
   * 改变天宫格的选中状态
   *
   * @param isSelect 当天是否被选中
   */
  onSelectChange(isSelect: boolean) {
    this.isSelect = isSelect;
    this.updateDayCell();
  }

  updateDayCell() {
    this.updateDateTextColor();
    this.updateTagTextContent();
    this.updateTagColor();
  }

  // 标签文本
  updateTagTextContent(): void {
    if (this.holiday.length !== 0) {
      const festivalAbbreviation: FestivalAbbreviation = FestivalAbbreviation.getInstance();
      if (festivalAbbreviation.hasHoliday(this.holiday)) {
        this.tagText = festivalAbbreviation.getHolidayName(this.holiday);
      } else {
        this.tagText = this.holiday;
      }
    } else if (this.term.length !== 0) {
      this.tagText = this.term;
    } else if (this.showLunar) {
      this.tagText = this.calendar;
    } else {
      this.tagText = '';
    }
    const maxStrLength: number = this.isSelect ? 3 : 4;
    this.popupContent = this.tagText;
    if (this.tagText.length > maxStrLength) {
      this.tagText = this.tagText.slice(0, maxStrLength - 1) + '...';
      this.isShowPopUp = true;
    } else {
      this.isShowPopUp = false;
    }
  }

  onCurrentDateChange(currentDate: Date) {
    this.isToday = this.parseIsToday(currentDate);
    this.updateDayCell();
  }

  /**
   * 判断当前天数据是否与实时时间相同
   */
  private parseIsToday(currentDate?: Date): boolean {
    let nowDate = currentDate || new Date();
    return this.dayData.solarYear == nowDate.getFullYear() &&
      this.dayData.solarMonth == nowDate.getMonth() + 1 &&
      this.dayData.solarDay == nowDate.getDate();
  }

  public onRecessDataChange(allRecessData: Map<number, RecessInfo>, isShowRecess: boolean) {
    this.showRecessData = isShowRecess;
    if (!CalendarUtils.isOldRecess) {
      this.calculateRecessNew(this.dayData, allRecessData);
    } else {
      this.calculateRecessOld(this.dayData, allRecessData);
    }
    this.updateRecessText();
  }

  private updateRecessText() {
    this.mark = this.dayData.dayMark;
    this.recessText = this.showRecessData ? this.dayData.dayMarkValue : '';
    if (this.mark === DayMark.OFF) {
      this.recessTextColor = $r('app.color.calendar_color_blue');
    } else if (this.mark === DayMark.WORK) {
      this.recessTextColor = $r('app.color.calendar_color_red');
    }
  }

  /**
   * 封装班休到具体的天中
   *
   * @param dayInfo "天"对象
   * @param data 班休数据
   */
  private calculateRecessNew(dayInfo: DayData, allRecessData: Map<number, RecessInfo>): void {
    if (dayInfo.dayMark !== DayMark.NORMAL) {
      return;
    }
    if (!allRecessData.has(dayInfo.solarYear)) {
      return;
    }
    const recessData: RecessInfo | undefined = allRecessData.get(dayInfo.solarYear);
    if (!recessData) {
      return;
    }

    const dayIndex = dayInfo.solarMonth * 100 + dayInfo.solarDay;
    const isOffDay = recessData.recessOffDays.includes(dayIndex);
    const isWorkDay = recessData.recessWorkDays.includes(dayIndex);

    if (isOffDay) {
      dayInfo.dayMark = DayMark.OFF;
      dayInfo.dayMarkValue = '休';
    } else if (isWorkDay) {
      dayInfo.dayMark = DayMark.WORK;
      dayInfo.dayMarkValue = '班';
    }
  }

  /**
   * 封装旧版班休到具体的天中
   *
   * @param dayInfo "天"对象
   * @param data 班休数据
   */
  private calculateRecessOld(dayInfo: DayData, allRecessData: Map<number, RecessInfo>): void {
    if (dayInfo.dayMark !== DayMark.NORMAL) {
      return;
    }

    try {
      let recessData: RecessInfo | undefined = undefined;
      // 处理12月的情况，尝试获取下一年的数据
      if (dayInfo.solarMonth === YearData.MONTH_OF_YEAR) {
        recessData = allRecessData.get(dayInfo.solarYear + 1);
      }

      // 如果recessData未找到，尝试获取当前年份的数据
      if (!recessData) {
        recessData = allRecessData.get(dayInfo.solarYear);
      }

      // 如果仍未找到，返回
      if (!recessData) {
        log.showWarn('calculateRecessOld recessData is empty');
        return;
      }

      let curJulianDay = DateUtil.date2julianDay(dayInfo.solarYear, dayInfo.solarMonth, dayInfo.solarDay);
      const isOffDay = recessData.recessOffDays.includes(curJulianDay);
      const isWorkDay = recessData.recessWorkDays.includes(curJulianDay);

      if (isOffDay) {
        dayInfo.dayMark = DayMark.OFF;
        dayInfo.dayMarkValue = '休';
      } else if (isWorkDay) {
        dayInfo.dayMark = DayMark.WORK;
        dayInfo.dayMarkValue = '班';
      }
    } catch (error) {
      log.showWarn(`calculateRecessOld failed,code: ${error?.code}, message: ${error?.message}`);
    }
  }

  finishWeekUpdateByButton(isCollapse: boolean) {
    this.isWeekView = isCollapse;
  }
}

