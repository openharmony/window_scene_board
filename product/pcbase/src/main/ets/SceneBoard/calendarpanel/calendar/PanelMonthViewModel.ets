// 月  -- 模型
@Observed
export class SingleMonthViewModel {
  public month: number;
  public year: number;
  public dayViewModels: SingleDayViewModelArray = new SingleDayViewModelArray;
  public showRecessData: boolean = false;
  public showLunarInfo: boolean = true;
  public monthInfo: MonthInfo | undefined = undefined;
  public monthTitle: string = '';
  public startOfWeek: number = 0;
  public weekends: number[] = [-1, 0, 6];
  public weekNum: number = 0;
  public static readonly dayItemCount: number = 6 * 7; // max number of day show items

  public hasDisplayDay: boolean = false;
  public isInit: boolean = false;
  public isWeekShow: boolean = false;
  // 当月视图的选中时间（由于规格问题，存在系统选中时间和视图选中时间不一致的情况（当前需要在其他月份有默认选中态（当月一号）））
  public selectDate: DateInfo = new DateInfo();
  public weekTitles: string[] = [];

  constructor(year: number, month: number, day: number = 1, startOfWeek: number) {
    log.showInfo(`create month view model ${year}:${month}:${day}`);
    this.month = month;
    this.year = year;
    this.startOfWeek = startOfWeek;
    this.selectDate = new DateInfo(year, month, day);

    //初始化用
    if (year === 0 && month === -1) {
      this.weekNum = 0;
      return;
    }
    this.isInit = true;

    this.monthInfo = DateManager.getInstance().getYearData(this.year)?.getMonthInfo(this.month);

    if (!this.monthInfo) {
      log.showError(`getMonthInfo failed ${this.year}:${this.month}`);
      return;
    }
    this.dayViewModels = new SingleDayViewModelArray();
    for (let index = 0; index < SingleMonthViewModel.dayItemCount; ++index) {
      this.dayViewModels.push(new SingleDayViewModel());
    }
    this.showLunarInfo = true;
    this.updateShowDaysInfo();
    this.initWeekTitles();
  }

  initWeekTitles() {
    this.weekTitles = YearViewLayoutManager.getInstance().getWeekTitles();
  }

  // 响应选中日期变化
  public onSelectedDateChange(selectDay: DateInfo) {
    const selectDayStamp =
      new Date(selectDay.year, selectDay.month - 1, selectDay.day).setHours(0, 0, 0, 0);
    const weekStartStamp = this.getWeekStartStamp(selectDayStamp);
    this.selectDate = new DateInfo(selectDay.year, selectDay.month, selectDay.day);

    // 月标题的颜色需要感知年份变化
    this.dayViewModels?.forEach((item) => {
      const itemStamp = item.dayData.getDate().setHours(0, 0, 0, 0);
      const itemStampIndex = Math.floor((itemStamp - weekStartStamp) / DateUtil.ONE_DAY_TIMESTAMP);
      if (item.day === selectDay.day && selectDay.month === this.month && selectDay.year === this.year &&
      item.isCurrentMonth) {
        item.isSelect = true;
        item.updateDayCell();
      } else {
        item.isSelect = false;
        item.updateDayCell();
      }
      if (itemStampIndex >= 0 && itemStampIndex < DateUtil.DAY_PER_WEEK) {
        item.isSelectWeekDays = true;
      } else {
        item.isSelectWeekDays = false;
      }
    });
    this.hasDisplayDay = (selectDay.month === this.month && selectDay.year === this.year);
  }

  private getWeekStartStamp(stamp: number): number {
    const date: Date = new Date(stamp);
    const dayOffset: number = date.getDay() - this.startOfWeek;
    const dayToStart: number = dayOffset >= 0 ? dayOffset : (DateUtil.DAY_PER_WEEK + dayOffset);
    return stamp - dayToStart * DateUtil.ONE_DAY_TIMESTAMP;
  }

  private updateShowDaysInfo() {
    if (this.startOfWeek < 0 || this.startOfWeek > 7) {
      log.showError('startOfWeek invalid y:' + this.startOfWeek);
      return;
    }

    if (!this.monthInfo) {
      log.showError('monthInfo invalid');
      return;
    }

    // check first day's week
    const days = this.monthInfo.getDaysInfo();
    if (!days || days.length === 0) {
      log.showError('updateShowDaysInfo failed y:' + this.year + 'm:' + this.month);
      return;
    }
    const firstDayWeek = days[0].getWeekDay();
    // case 1 : firstDayWeek is 0 and startOfWeek is 1; need 6 space
    // case 2 : firstDayWeek is 1 and startOfWeek is 0; need 1 space
    let space: number = 0;
    if (firstDayWeek >= this.startOfWeek) {
      space = firstDayWeek - this.startOfWeek;
    } else {
      space = 7 - this.startOfWeek + firstDayWeek;
    }

    if (!this.dayViewModels) {
      return;
    }

    //填充上月数据
    let lastMonthInfo: MonthInfo | undefined = this.monthInfo.getLast();
    if (lastMonthInfo) {
      let lastDays = lastMonthInfo.getDaysInfo();
      for (let index = 0; index < space; ++index) {
        this.dayViewModels[index].update(lastDays[lastDays.length - space + index],
          this.showRecessData, this.showLunarInfo, this.weekends, false);
      }
    } else {
      for (let index = 0; index < space; ++index) {
        this.dayViewModels[index].update();
      }
    }

    // insert cur month info
    days.forEach((element, index) => {
      this.dayViewModels[space + index].update(element, this.showRecessData, this.showLunarInfo, this.weekends);
    });

    //填充下月日期并计算当月显示行数
    let showDays = space + days.length;
    this.weekNum = showDays > 35 ? 6 : 5;
    let nextMonthInfo: MonthInfo | undefined = this.monthInfo.getNext();
    if (nextMonthInfo) {
      let nextDays = nextMonthInfo.getDaysInfo();
      let nextSpace = this.weekNum * 7 - showDays;
      for (let index = 0; index < nextSpace; ++index) {
        this.dayViewModels[index + showDays].update(nextDays[index], false, this.showLunarInfo, this.weekends, false);
      }
    }

    this.onSelectedDateChange(this.selectDate);
  }

  onCurrentDateChange(currentDate: Date) {
    this.dayViewModels.forEach((element, index) => {
      element.onCurrentDateChange(currentDate);
    });
  }

  public onStartOfWeekChange(startOfWeek: number) {
    this.startOfWeek = startOfWeek;
    YearViewLayoutManager.getInstance().onStartOfWeekChange(this.startOfWeek);
    this.weekTitles = YearViewLayoutManager.getInstance().weekTitles;
    this.dayViewModels = new SingleDayViewModelArray();
    for (let index = 0; index < SingleMonthViewModel.dayItemCount; ++index) {
      this.dayViewModels.push(new SingleDayViewModel());
    }
    this.updateShowDaysInfo();
  }

  public finishWeekUpdateByButton(isCollapse: boolean): void {
    this.isWeekShow = isCollapse;
    this.dayViewModels?.forEach((model, index) => {
      model.finishWeekUpdateByButton(isCollapse);
    });
  }

  public getRowsTemplate(): string {
    return this.isWeekShow ? '1f' : (this.weekNum === 6 ? '1fr 1fr 1fr 1fr 1fr 1fr' : '1fr 1fr 1fr 1fr 1fr');
  }

  public isWeekView(index: number): boolean {
    return this.isWeekShow ? (this.dayViewModels[index].isSelectWeekDays ? true : false) : true;
  }

  public onColorModeChange(currColorMode: number): void {
    this.dayViewModels?.forEach((item) => {
      item.colorModeViewModel.onColorModeChange(currColorMode);
      item.updateDayCell();
    });
  }

  public onLanguageChange() {
    this.weekTitles = YearViewLayoutManager.getInstance().getWeekTitles();
  }

  public onRecessDataChange(allRecessData: Map<number, RecessInfo>, isShowRecess: boolean) {
    this.showRecessData = isShowRecess;
    this.dayViewModels.forEach((singleDayViewModel: SingleDayViewModel) => {
      singleDayViewModel?.onRecessDataChange(allRecessData, isShowRecess);
    });
  }
}

